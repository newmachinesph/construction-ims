# Copy to .env for local dev. Never commit .env (.env* is gitignored).
# For production see .env.production (or paste these into Vercel's env settings).

# --- Database (required) ---------------------------------------------------
# Local Docker Postgres (docker compose up), or a Neon branch URL.
DATABASE_URL=postgresql://ims:ims_dev_password@localhost:5433/ims

# --- Cloudflare R2 (required for material / delivery photos) ----------------
# S3-compatible object storage. Server-side only — never prefix these with
# NEXT_PUBLIC_, or the secret ships in the client bundle.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=construction-ims
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# --- Not required (kept here so nobody re-adds them) ------------------------
# NODE_ENV        — set by next build / next start / the host. Don't set it manually.
# SESSION_SECRET  — not used. Sessions are opaque random tokens (randomBytes(32));
#                   only a SHA-256 hash is stored, so there is nothing to sign.
# R2_ACCOUNT_ID   — not used.
# R2_PUBLIC_URL   — not used. The bucket is private; photos stream through the
#                   auth-gated route GET /api/attachments/[id]/raw.
