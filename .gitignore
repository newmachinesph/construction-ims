# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never get committed.
.env*
# ...except the example, which documents the required variables. Without this the
# repo ships no record of what a deployer must set.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI-orchestration generated artifacts (not part of the application source)
CLAUDE.md
AGENTS.md
.claude/
.impeccable/
.cursor/
.aider*
/docs/PH-RESEARCH.md
/screenshots/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/e2e/.image-cache/
seed-run.log
backfill.log
devserver.log
_*.mjs
.gstack/
